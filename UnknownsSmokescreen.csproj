<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <Version>0.3.0.10</Version>
        <Description>Unknown's Smokescreen - stream protection for The Other Roles: while Streamer Mode is on, recording software sees Crewmate and no private team information.</Description>
        <Authors>DaUnknown-0</Authors>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <Platforms>AnyCPU</Platforms>
        <AssemblyName>UnknownsSmokescreen</AssemblyName>
        <RootNamespace>UnknownsSmokescreen</RootNamespace>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2024.10.29" />
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" />
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.697" />
    </ItemGroup>

    <!-- TOR DLL location: defaults to the local build, overridable in CI via -p:TheOtherRolesDll=... -->
    <PropertyGroup>
        <TheOtherRolesDll Condition="'$(TheOtherRolesDll)' == ''">..\TheOtherRoles-main\TheOtherRoles-main\TheOtherRoles\bin\Debug\net6.0\TheOtherRoles.dll</TheOtherRolesDll>
    </PropertyGroup>

    <!-- TOR is the only dependency. Everything is local to this client: no RPCs, no host needed. -->
    <ItemGroup>
        <Reference Include="TheOtherRoles">
            <HintPath>$(TheOtherRolesDll)</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
</Project>
